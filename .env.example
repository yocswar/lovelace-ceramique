# Configuration locale du projet Lovelace Céramique
# Copier ce fichier : cp .env.example .env
# Ne JAMAIS commiter .env (il est listé dans .gitignore)

# --- Application ---
# Environnement d'exécution (development ou production)
APP_ENV=development
# Port publié par Nginx : API accessible sur http://localhost:APP_PORT
APP_PORT=8080
# Port publié par le serveur Vite (frontend) : http://localhost:FRONTEND_PORT
FRONTEND_PORT=5173

# --- PostgreSQL ---
# Valeurs de développement uniquement, à modifier en production
POSTGRES_DB=lovelace
POSTGRES_USER=lovelace
POSTGRES_PASSWORD=lovelace_dev
# Port publié sur la machine hôte (dans Docker, PostgreSQL reste sur 5432)
POSTGRES_PORT=5432

# --- pgAdmin ---
# Valeurs de développement uniquement, à modifier en production
PGADMIN_PORT=5050
PGADMIN_EMAIL=ada@example.com
PGADMIN_PASSWORD=ada_dev

# --- Authentification ---
# OBLIGATOIRE : à remplir avec une valeur aléatoire d'au moins 32 octets.
# Générer la valeur avec : openssl rand -base64 32
# Chaque développeur génère la sienne. Ne jamais commiter ni partager un secret réel.
# Laissée vide, l'authentification ne fonctionne pas.
JWT_SECRET=
